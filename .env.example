# ShadowAI — local configuration
#
# Copy to `.env` and fill in. Vite loads VITE_* variables automatically.
# `.env` is gitignored; never commit credentials.

# --- Shadow v1.1 model space (Hugging Face) -----------------------------------
# Settings → Model lets you override both of these at runtime.
VITE_SHADOW_SPACE_URL=https://your-space.hf.space
VITE_SHADOW_SPACE_TOKEN=hf_...

# --- optional backend proxy --------------------------------------------------
# Use when the credential must not sit in the browser.
# PORT=8787
# SHADOWAI_BASE_URL=https://your-endpoint/v1
# SHADOWAI_API_KEY=sk-...
# SHADOWAI_MODEL=your-model-id

# --- built frontend pointed at a backend on another origin --------------------
# VITE_SHADOWAI_API=https://api.your-domain.com
